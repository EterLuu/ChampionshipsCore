<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ink.ziip</groupId>
        <artifactId>championships-parent</artifactId>
        <version>1.3-SNAPSHOT</version>
    </parent>
    <artifactId>championships-bingo-worker</artifactId>
    <name>Championships Bingo Folia Worker</name>

    <dependencies>
        <dependency>
            <groupId>ink.ziip</groupId>
            <artifactId>championships-common</artifactId>
        </dependency>
        <dependency>
            <groupId>ink.ziip</groupId>
            <artifactId>championships-bingo-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>ink.ziip</groupId>
            <artifactId>championships-platform-bukkit</artifactId>
        </dependency>
        <dependency>
            <groupId>ink.ziip</groupId>
            <artifactId>championships-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.12.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>fr.mrmicky</groupId>
            <artifactId>fastboard</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}/../championships-core/src/main/resources/bingo/taskimages</directory>
                <targetPath>bingo/taskimages</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <artifactSet>
                        <includes>
                            <include>ink.ziip:championships-common</include>
                            <include>ink.ziip:championships-bingo-engine</include>
                            <include>ink.ziip:championships-platform-bukkit</include>
                            <include>ink.ziip:championships-redis</include>
                            <include>io.lettuce:lettuce-core</include>
                            <include>io.netty:*</include>
                            <include>io.projectreactor:reactor-core</include>
                            <include>org.reactivestreams:reactive-streams</include>
                            <include>io.redis:redis-authx-core</include>
                            <include>fr.mrmicky:fastboard</include>
                        </includes>
                    </artifactSet>
                    <relocations>
                        <relocation>
                            <pattern>io.lettuce</pattern>
                            <shadedPattern>ink.ziip.championshipscore.worker.libs.io.lettuce</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>io.netty</pattern>
                            <shadedPattern>ink.ziip.championshipscore.worker.libs.io.netty</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>reactor</pattern>
                            <shadedPattern>ink.ziip.championshipscore.worker.libs.reactor</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.reactivestreams</pattern>
                            <shadedPattern>ink.ziip.championshipscore.worker.libs.org.reactivestreams</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>io.redis</pattern>
                            <shadedPattern>ink.ziip.championshipscore.worker.libs.io.redis</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>fr.mrmicky.fastboard</pattern>
                            <shadedPattern>ink.ziip.championshipscore.worker.libs.fastboard</shadedPattern>
                        </relocation>
                    </relocations>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>module-info.class</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
